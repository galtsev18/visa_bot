# =============================================================================
# REQUIRED IN .ENV — only these are read from .env; rest from spreadsheet "Settings" sheet
# =============================================================================
# Google Sheets ID from URL: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEETS_ID}/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
# Path to Google Service Account credentials JSON (from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# All other settings go in the spreadsheet "Settings" sheet (columns: key, value):
# TELEGRAM_BOT_TOKEN, TELEGRAM_MANAGER_CHAT_ID, FACILITY_ID, REFRESH_INTERVAL,
# SHEETS_REFRESH_INTERVAL, CACHE_TTL, ROTATION_COOLDOWN,
# AIS_REQUEST_DELAY_SEC, AIS_RATE_LIMIT_BACKOFF_SEC (AIS-only),
# VFS_REQUEST_DELAY_SEC, VFS_RATE_LIMIT_BACKOFF_SEC (VFS-only),
# CAPTCHA_2CAPTCHA_API_KEY
# Google API quota and portal rate limits use progressive backoff (see docs).

# -----------------------------------------------------------------------------
# VFS proxy (cabinet often only from country IP, e.g. Russia; Geonix: https://geonix.com)
# -----------------------------------------------------------------------------
# Geonix API key from https://geonix.com/personal/api/ (optional; or set in Settings sheet)
# GEONIX_API_KEY=
# Country for proxy when using Geonix (default: Russia)
# VFS_PROXY_COUNTRY=Russia
# Or set a single proxy URL (overrides Geonix): http://login:password@host:port
# VFS_PROXY_URL=
